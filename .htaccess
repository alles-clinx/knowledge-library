Options -Indexes -MultiViews
DirectoryIndex index.html
RedirectMatch 301 ^/knowledge/about(?:/.*)?$ /knowledge/
RedirectMatch 301 ^/knowledge/sitemap/?$ /knowledge/
RedirectMatch 301 ^/knowledge/(?:cookie-policy|ai-data-use|accessibility|trust-security)/?$ /knowledge/privacy-policy/
AddType application/manifest+json .webmanifest
AddType application/xml .xml
<FilesMatch "^(sitemap|google-sitemap)\.xml$">
  ForceType application/xml
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^(sitemap|google-sitemap)\.xml$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  <Files "offline.html">
    Header set X-Robots-Tag "noindex, follow"
  </Files>
</IfModule>
