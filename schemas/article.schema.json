{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alle's ClinX Knowledge Article Source",
  "type": "object",
  "required": [
    "article_id",
    "locale",
    "language",
    "editorial_status",
    "title",
    "slug",
    "category",
    "category_slug",
    "subcategory",
    "subcategory_slug",
    "excerpt",
    "content_html",
    "seo_title",
    "meta_description",
    "related_article_ids",
    "wordpress_status",
    "license",
    "attribution"
  ],
  "properties": {
    "article_id": {"type":"string","pattern":"^ACX-KB-[0-9]{4}$"},
    "locale": {"type":"string"},
    "language": {"type":"string"},
    "editorial_status": {"type":"string"},
    "translation_status": {"type":"string"},
    "title": {"type":"string","minLength":3},
    "slug": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "category": {"type":"string"},
    "category_slug": {"type":"string"},
    "subcategory": {"type":"string"},
    "subcategory_slug": {"type":"string"},
    "excerpt": {"type":"string"},
    "content_html": {"type":"string"},
    "seo_title": {"type":"string"},
    "meta_description": {"type":"string"},
    "related_article_ids": {"type":"array","items":{"type":"string"}},
    "wordpress_status": {"const":"draft"},
    "license": {"const":"CC BY 4.0"},
    "attribution": {"const":"Alle's ClinX Open Knowledge"}
  },
  "additionalProperties": true
}